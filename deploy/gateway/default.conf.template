server_tokens off;

server {
    listen 8080;
    server_name ${TLS_SERVER_NAME};
    return 308 ${APP_PUBLIC_URL}$request_uri;
}

server {
    listen 8443 ssl;
    server_name ${TLS_SERVER_NAME};
    resolver 127.0.0.11 valid=1s ipv6=off;
    ssl_certificate /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Nginx uses internal status 497 for HTTP sent to the TLS listener.
    error_page 497 =308 ${APP_PUBLIC_URL}$request_uri;
    client_max_body_size ${MAX_REQUEST_BODY_BYTES};

    location / {
        # Re-resolve the web container after Compose restarts or recreates it.
        set $web_upstream web:8000;
        proxy_pass http://$web_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}

server {
    listen 127.0.0.1:8081;
    location = /health { return 200; }
}
