# Explicit release tag or digest; never use latest or a development build in production.
IPTABLE_IMAGE=
# Production Compose enforces this value even if this file is changed.
APP_ENV=production
# HTTPS listens only on localhost until a private LAN/VPN address is configured.
HTTPS_BIND_ADDRESS=127.0.0.1
# HTTPS host port. No backend or database ports are published.
HTTPS_PORT=443
# Directory relative to deploy/ containing fullchain.pem and privkey.pem.
# Files must be readable by proxy UID/GID 101; keep the private key non-public.
TLS_CERT_DIR=./tls
# Independent production database identity; do not reuse development credentials.
POSTGRES_USER=iptable_prod
POSTGRES_DB=iptable_prod
# Generated by scripts/init_production.py. Use URL-safe characters in this password.
POSTGRES_PASSWORD=
# Random stable cookie-signing key, at least 32 characters. Never commit real values.
SECRET_KEY=
# Bootstrap administrator. Password applies only when creating the account.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
# Web interface language: RU or EN.
INTERFACE_LANGUAGE=RU
# Idle session expiry, in seconds.
SESSION_IDLE_TIMEOUT_SECONDS=86400
# Optional integration token. Leave empty to disable the REST API.
INTEGRATION_API_TOKEN=
# Remaining optional application settings and defaults are documented in ../.env.example.
