# Application display name.
APP_NAME=IPtable

# Runtime environment: local or production. Production requires SECRET_KEY and disables OpenAPI UI.
APP_ENV=local

# Host port exposed by docker-compose for the web application.
APP_PORT=8000

# Secret used to sign session cookies. Use a long random value and never commit the real one.
SECRET_KEY=replace-with-random-32-plus-character-secret

# Idle session timeout in seconds. Default is 24 hours.
SESSION_IDLE_TIMEOUT_SECONDS=86400

# Failed login attempts allowed within the rate limit window.
LOGIN_RATE_LIMIT_ATTEMPTS=5

# Login rate limit accounting window in seconds.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Login lockout duration in seconds after too many failed attempts.
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900

# Optional REST API token. Empty value disables /api/v1 endpoints by default.
INTEGRATION_API_TOKEN=

# Web interface language. Supported values: RU, EN.
INTERFACE_LANGUAGE=RU

# Initial administrator username managed from environment.
INITIAL_ADMIN_USERNAME=admin

# Initial administrator password used only when the admin user is created for the first time.
INITIAL_ADMIN_PASSWORD=replace-with-strong-admin-password

# PostgreSQL username used by the application.
POSTGRES_USER=iptable

# PostgreSQL password. Use a strong local secret and keep it out of Git.
POSTGRES_PASSWORD=replace-with-strong-local-password

# PostgreSQL database name.
POSTGRES_DB=iptable

# SQLAlchemy database URL used by web, worker, migrations and scripts.
DATABASE_URL=postgresql+psycopg://iptable:replace-with-strong-local-password@postgres:5432/iptable

# Default ping interval in seconds for project/folder schedules.
PING_INTERVAL_SECONDS=3600

# Timeout in seconds for a single ICMP ping.
PING_TIMEOUT_SECONDS=2

# Maximum concurrent ping processes within one batch.
PING_CONCURRENCY=8

# Number of IP addresses checked per batch.
PING_BATCH_SIZE=32

# Pause in seconds between ping batches inside one project.
PING_BATCH_PAUSE_SECONDS=1

# Pause in seconds between project-level ping jobs.
PING_PROJECT_PAUSE_SECONDS=5

# Worker polling interval in seconds for queue and schedules.
PING_QUEUE_POLL_SECONDS=5

# Timeout after which a running ping job is considered stale and requeued.
PING_RUNNING_JOB_TIMEOUT_SECONDS=7200

# Default number of rows shown in a project table page.
PROJECT_TABLE_DEFAULT_PAGE_SIZE=25

# Safety limit for generated IP rows in one project.
MAX_PROJECT_ADDRESSES=4096

# Maximum CSV/XLSX import upload size in bytes.
CSV_IMPORT_MAX_BYTES=2097152

# Enable embedded ping worker inside the web process. Docker Compose uses a separate worker service.
ENABLE_PING_WORKER=false
