# Required for the bundled PostgreSQL database. Keep after setup.
POSTGRES_PASSWORD=
# Initial administrator. Use a password of at least 12 characters.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
# HTTP port and host IP. See the README for remote access and HTTPS.
APP_PORT=8000
APP_BIND_ADDRESS=127.0.0.1
# Initial installation defaults. Users can override these in Settings.
INTERFACE_LANGUAGE=EN
INTERFACE_THEME=blue
