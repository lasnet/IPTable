# Optional settings for docker-compose.yml. You can edit Compose directly instead.
# Required: choose a unique database password.
POSTGRES_PASSWORD=
# Required: random session-signing key, at least 32 characters. Keep it across updates.
SECRET_KEY=
# Required: initial administrator password, at least 12 characters.
INITIAL_ADMIN_PASSWORD=
# Administrator login; changing it transfers the administrator role.
INITIAL_ADMIN_USERNAME=admin
# Web server port and listen address.
APP_PORT=8000
APP_BIND_ADDRESS=0.0.0.0
# Application display name and interface language: RU or EN.
APP_NAME=IPtable
INTERFACE_LANGUAGE=RU
# Production disables OpenAPI UI; local is for development.
APP_ENV=production
# Set true when the application is accessed through your HTTPS reverse proxy.
SESSION_COOKIE_SECURE=false
# Idle session expiry in seconds.
SESSION_IDLE_TIMEOUT_SECONDS=86400
# Failed-login limit, accounting window and lockout duration in seconds.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900
# Optional integration token; an empty value disables REST API access.
INTEGRATION_API_TOKEN=
# Database user and database name; the password is set above.
POSTGRES_USER=iptable
POSTGRES_DB=iptable
# Optional existing database override. Leave empty for the bundled PostgreSQL.
DATABASE_URL=
# Ping schedule interval and single-probe timeout in seconds.
PING_INTERVAL_SECONDS=3600
PING_TIMEOUT_SECONDS=2
# Limit ICMP load: concurrency, addresses per batch and pauses in seconds.
PING_CONCURRENCY=8
PING_BATCH_SIZE=32
PING_BATCH_PAUSE_SECONDS=1
PING_PROJECT_PAUSE_SECONDS=5
# Queue polling interval and stale running-job timeout in seconds.
PING_QUEUE_POLL_SECONDS=5
PING_RUNNING_JOB_TIMEOUT_SECONDS=7200
# Table pagination, maximum subnet size and import size in bytes.
PROJECT_TABLE_DEFAULT_PAGE_SIZE=25
MAX_PROJECT_ADDRESSES=4096
CSV_IMPORT_MAX_BYTES=2097152
