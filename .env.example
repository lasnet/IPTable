# First start. Set both passwords and keep POSTGRES_PASSWORD after setup.
POSTGRES_PASSWORD=
INITIAL_ADMIN_USERNAME=admin
# Use at least 12 characters. Remove this line after the first successful sign-in.
INITIAL_ADMIN_PASSWORD=

# Network. The defaults publish HTTP on the Docker host's loopback address.
APP_PORT=8000
APP_BIND_ADDRESS=127.0.0.1
# For remote access, uncomment and set the URL users open in their browser.
# For HTTPS, use https:// and the external hostname or IP.
# APP_PUBLIC_URL=http://192.168.10.10:8000

# Initial installation defaults. Users can override these in Settings.
INTERFACE_LANGUAGE=EN
INTERFACE_THEME=blue

# Built-in HTTPS. Uncomment this block, set HTTPS_ENABLED=true, and use your certificate paths.
# Set APP_PUBLIC_URL to your HTTPS URL and APP_BIND_ADDRESS to the Docker host's network IP above.
# Keep COMPOSE_PATH_SEPARATOR and COMPOSE_FILE as shown when enabling the gateway.
# HTTPS_ENABLED=false
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:deploy/https/${HTTPS_ENABLED:-false}.yml
# HTTPS_PORT=443
# TLS_CERT_FILE=/srv/iptable/tls/fullchain.pem
# TLS_KEY_FILE=/srv/iptable/tls/privkey.pem
# TLS_KEY_GID=0

# External HTTPS proxy. Set APP_PUBLIC_URL and APP_BIND_ADDRESS above and allow your proxy's IP here.
# Keep HTTPS_ENABLED=false when the external proxy handles HTTPS.
# TRUSTED_PROXY_IPS=192.168.1.10

# Advanced deployment options. Uncomment only the settings you need to override.
# Set the project name before the first start. Keep it for an existing installation.
# COMPOSE_PROJECT_NAME=iptable
# POSTGRES_USER=iptable
# POSTGRES_DB=iptable
# POSTGRES_APP_USER=auto
# MAX_REQUEST_BODY_BYTES=3145728
# DATABASE_URL=
# MIGRATION_DATABASE_URL=

# Upgrade only. Keep the existing key here until the first successful start of the new version.
# SECRET_KEY=
