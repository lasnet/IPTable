# Optional settings for docker-compose.yml. You can edit Compose directly instead.
# Required: choose a unique database password.
POSTGRES_PASSWORD=
# Required: random session-signing key, at least 32 characters. Keep it across updates.
SECRET_KEY=
# Required: initial administrator password, at least 12 characters.
INITIAL_ADMIN_PASSWORD=
# Administrator login; changing it transfers the administrator role.
INITIAL_ADMIN_USERNAME=admin
# Default: HTTP, without an nginx container or certificates.
# To enable bundled HTTPS: set true, an HTTPS APP_PUBLIC_URL, and TLS_* below.
HTTPS_ENABLED=false
# Compose selects the matching fragment. Keep HTTPS_ENABLED above COMPOSE_FILE
# (dotenv expands variables in file order); keep these two lines unchanged.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:deploy/https/${HTTPS_ENABLED:-false}.yml
# HTTP port; with bundled HTTPS this port redirects to APP_PUBLIC_URL.
APP_PORT=8000
APP_BIND_ADDRESS=0.0.0.0
# Browser-facing origin, no trailing slash/path. Use your server's DNS name/IP.
# With a shared external proxy: keep HTTPS_ENABLED=false, set https://... here,
# restrict APP_BIND_ADDRESS/firewall to that proxy, and configure its upstream.
APP_PUBLIC_URL=http://localhost:8000
# Bundled HTTPS only (Docker Compose >=2.24.4). Certificate must cover this name.
# APP_PUBLIC_URL must include HTTPS_PORT if it is not 443.
HTTPS_PORT=443
TLS_SERVER_NAME=
# Absolute paths on the Docker host: PEM full chain and matching unencrypted key.
# Mounted read-only. Must be readable by container UID 101 / configured group.
# Never commit certificates/private keys. No certificate is generated automatically.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Supplementary group allowed to read the key (e.g. root-owned key, mode 640).
TLS_KEY_GID=0
# External proxy only: trusted proxy IP(s)/CIDR(s), comma-separated; never '*' on
# a publicly accessible backend. Default trusts loopback only.
TRUSTED_PROXY_IPS=127.0.0.1
# Application display name and interface language: RU or EN.
# Imported into the database on first start; afterwards edit in Settings as admin.
APP_NAME=IPtable
INTERFACE_LANGUAGE=RU
# Production disables OpenAPI UI; local is for development.
APP_ENV=production
# Secure cookies and HSTS are automatic when APP_PUBLIC_URL starts with https://.
# HTTP keeps production secret validation and disables OpenAPI, but is unencrypted.
# Idle session expiry in seconds.
# Imported once on first start; afterwards edit in Settings.
SESSION_IDLE_TIMEOUT_SECONDS=86400
# Failed-login limit, accounting window and lockout duration in seconds.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900
# Optional integration token; an empty value disables REST API access.
# Imported once; afterwards create/replace/disable the token in Settings.
INTEGRATION_API_TOKEN=
# Database user and database name; the password is set above.
POSTGRES_USER=iptable
POSTGRES_DB=iptable
# Optional existing database override. Leave empty for the bundled PostgreSQL.
DATABASE_URL=
# Ping schedule interval and single-probe timeout in seconds.
# Imported once; afterwards edit defaults and worker limits in Settings.
PING_INTERVAL_SECONDS=3600
PING_TIMEOUT_SECONDS=2
# Limit ICMP load: concurrency, addresses per batch and pauses in seconds.
PING_CONCURRENCY=8
PING_BATCH_SIZE=32
PING_BATCH_PAUSE_SECONDS=1
PING_PROJECT_PAUSE_SECONDS=5
# Queue polling interval and stale running-job timeout in seconds.
PING_QUEUE_POLL_SECONDS=5
PING_RUNNING_JOB_TIMEOUT_SECONDS=7200
# Table pagination, maximum subnet size and import size in bytes.
# Imported once; afterwards edit in Settings.
PROJECT_TABLE_DEFAULT_PAGE_SIZE=25
MAX_PROJECT_ADDRESSES=4096
CSV_IMPORT_MAX_BYTES=2097152
