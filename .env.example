APP_NAME=IPtable
APP_ENV=local
APP_PORT=8000
SECRET_KEY=replace-with-random-32-plus-character-secret
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-strong-admin-password

POSTGRES_USER=iptable
POSTGRES_PASSWORD=replace-with-strong-local-password
POSTGRES_DB=iptable
DATABASE_URL=postgresql+psycopg://iptable:replace-with-strong-local-password@postgres:5432/iptable

PING_INTERVAL_SECONDS=3600
PING_TIMEOUT_SECONDS=2
PING_CONCURRENCY=64
MAX_PROJECT_ADDRESSES=4096
ENABLE_PING_WORKER=true
